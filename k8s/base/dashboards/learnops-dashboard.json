{
  "title": "LearnOps Platform",
  "uid": "learnops-platform",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Events Ingested (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(learnops_events_ingested_total[5m])", "legendFormat": "ingested" }
      ]
    },
    {
      "id": 2,
      "title": "Events Processed (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(learnops_events_processed_total[5m])", "legendFormat": "processed" }
      ]
    },
    {
      "id": 3,
      "title": "Events Failed (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(learnops_events_failed_total[5m])", "legendFormat": "failed" }
      ]
    },
    {
      "id": 4,
      "title": "ingest-api Replicas",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "kube_deployment_status_replicas{deployment=\"ingest-api\"}", "legendFormat": "replicas" }
      ]
    }
  ],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": {} }
    ]
  }
}
